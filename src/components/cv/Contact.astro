---
import { Icon } from "astro-icon/components";
interface Props {
    contacts: Object[];
}
const { contacts } = Astro.props;
---

<div
    style="display:flex; flex-flow:row wrap;  align-content:flex-start; width:100%; padding:0; margin: 0;"
>
    {
        contacts.map((item) => (
            <a style="flex-grow: 1;" href={item.address} set:html={item.text}>
                <Icon class="icon" focusable="false" name={item.icon} />
            </a>
        ))
    }
</div>
