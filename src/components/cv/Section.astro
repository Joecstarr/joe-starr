---
import CVSubsction from "~/components/cv/Subsection.astro";
import { Icon } from "astro-icon/components";
interface Props {
    section: Object;
}
marked.use({
    breaks: false,
});
marked.Renderer.prototype.paragraph = function (text) {
    return text + "\n";
};
const { section } = Astro.props;
import { marked } from "marked";
const title = marked.parse(section.title);
---

<div>
    <h3 class="section_title" set:html={title}>
        <Icon class="icon" focusable="false" name={section.icon} />
    </h3>
    <div class="hr"></div>
    <div class={section.full == true && "summary_full"}>
        {
            section.subsections &&
                section.subsections.map((item, index, array) => (
                    <div>
                        <CVSubsction section={item} />

                        <div class={index !== array.length - 1 && "hrlite"} />
                    </div>
                ))
        }
    </div>
</div>
