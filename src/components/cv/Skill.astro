---
import { Icon } from "astro-icon/components";

interface Props {
    skill: Object;
}
const { skill } = Astro.props;
---

<div>
    {
        skill.section &&
            skill.section.map((sec) => (
                <div>
                    <h6 style="padding-top:.1rem;font-weight:bold;font-size:.9em">{sec.title}</h6>
                    <ul
                        class="skills"
                        style={
                            "display:grid;  grid-template-columns: repeat(auto-fill, minmax(" +
                            Math.max(
                                Math.max.apply(
                                    Math,
                                    sec.bullets.map(function (el) {
                                        return el.name.length;
                                    }),
                                ),
                                9,
                            ) *
                                0.6 +
                            "rem, 1fr)); "
                        }
                    >
                        {sec &&
                            sec.bullets.map((item) => (
                                <li class="skill_li">
                                    <div style="display:inline-block;">
                                        <div style="display:flex;align-items:center;">
                                            <div class="skill">{item.name}</div>
                                            {item.level &&
                                                Array(item.level)
                                                    .fill(1)
                                                    .map((x) => (
                                                        <Icon
                                                            class="skill_icon filled"
                                                            focusable="false"
                                                            name="fa7-solid:star"
                                                        />
                                                    ))}
                                            {item.level &&
                                                Array(5 - item.level)
                                                    .fill(1)
                                                    .map((x) => (
                                                        <Icon
                                                            class="skill_icon empty"
                                                            focusable="false"
                                                            name="fa7-solid:star"
                                                        />
                                                    ))}
                                        </div>
                                    </div>
                                </li>
                            ))}
                    </ul>
                </div>
            ))
    }
</div>
