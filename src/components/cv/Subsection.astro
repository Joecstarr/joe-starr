---
interface Props {
    section: Object;
}
const { section } = Astro.props;
import { marked } from "marked";
marked.Renderer.prototype.paragraph = function (text) {
    return text + "\n";
};
marked.use({
    breaks: false,
});

const name = marked.parse(section.name);
const subheader = section.subheader
    ? marked.parse(section.subheader.replaceAll(/\n\n/g, "\n<br/>\n"))
    : undefined;
const summary = section.summary
    ? marked.parse(section.summary.replaceAll(/\n\n/g, "\n<br/>\n"))
    : undefined;
const dates = section.dates
    ? marked.parse(section.dates.replaceAll(/\n\n/g, "\n<br/>\n"))
    : undefined;
---

<div class="subsection">
    <div class="flex">
        <div class="left">
            <h5 set:html={name} />
            {subheader && <h6 class="left" set:html={subheader} />}
        </div>
        {dates && <div class="right" set:html={dates} />}
    </div>
    {summary && <div class="summary" set:html={summary} />}
</div>
