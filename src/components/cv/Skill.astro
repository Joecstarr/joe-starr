---
import { Icon } from "astro-icon/components";

interface Props {
    skill: Object;
}
const { skill } = Astro.props;
---

<div>
    {
        skill.section &&
            skill.section.map((sec) => (
                <div>
                    <h6 style="padding-top:.1rem;font-weight:bold;font-size:.9em">{sec.title}</h6>

                    <div style="display:flex;align-items:center;">
                        {sec &&
                            sec.bullets.map((item) => {
                                return item.name + ", ";
                            })}
                    </div>
                </div>
            ))
    }
</div>
